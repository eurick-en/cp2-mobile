rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function validNotificationPolicy(policy) {
      return policy in [
        'all_group_messages',
        'mentioned_members',
        'direct_messages_only',
        'disabled'
      ];
    }

    match /users/{userId} {

      allow create: if isAuthenticated()
                    && request.auth.uid == userId;

      allow read: if isAuthenticated();

      allow update, delete:
        if isAuthenticated()
        && request.auth.uid == userId;

      match /devices/{deviceId} {

        allow create, read, update, delete:
          if isAuthenticated()
          && request.auth.uid == userId;
      }
    }

    match /directConversations/{conversationId} {

      allow get: if isAuthenticated()
                 && (
                   !exists(
                     /databases/$(database)/documents/directConversations/$(conversationId)
                   )
                   ||
                   request.auth.uid in resource.data.participantIds
                 );

      allow list: if isAuthenticated()
                  && request.auth.uid in resource.data.participantIds;

      allow create: if isAuthenticated()
                    && request.resource.data.id == conversationId
                    && request.resource.data.type == 'direct'
                    && request.resource.data.participantIds is list
                    && request.resource.data.participantIds.size() == 2
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.participantIds[0]
                       != request.resource.data.participantIds[1];

      allow update, delete: if false;
    }

    match /groups/{groupId} {

      allow create: if isAuthenticated()
                    && request.resource.data.id == groupId
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberIds is list
                    && request.resource.data.ownerId
                       in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() >= 2
                    && request.resource.data.memberLimit is int
                    && request.resource.data.memberLimit >= 2
                    && request.resource.data.memberIds.size()
                       <= request.resource.data.memberLimit
                    && validNotificationPolicy(
                      request.resource.data.notificationPolicy
                    );

      allow read: if isAuthenticated()
                  && request.auth.uid
                     in resource.data.memberIds;

      allow update: if isAuthenticated()
                    && request.auth.uid
                       == resource.data.ownerId
                    && request.resource.data.ownerId
                       == resource.data.ownerId
                    && request.resource.data.memberIds is list
                    && request.resource.data.ownerId
                       in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() >= 2
                    && request.resource.data.memberLimit is int
                    && request.resource.data.memberLimit >= 2
                    && request.resource.data.memberIds.size()
                       <= request.resource.data.memberLimit
                    && validNotificationPolicy(
                      request.resource.data.notificationPolicy
                    );

      allow delete: if isAuthenticated()
                    && request.auth.uid
                       == resource.data.ownerId;
    }
  }
}